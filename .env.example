# Chave da API da Anthropic. Sem ela o sistema so roda em --dry-run.
ANTHROPIC_API_KEY=

# Sobrescreve o modelo padrao (opcional).
CI_MODEL=claude-opus-5

# Nivel de esforco: low | medium | high | xhigh | max
CI_EFFORT=high

# Caminho do banco de conhecimento (opcional).
CI_DB_PATH=data/knowledge_base.db
